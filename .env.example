DATABASE_URL="mysql://root:root@localhost:3306/inmobiliaria"
JWT_SECRET="super-secret-change-in-production"
PORT=3000

# Pasarela de Pagos QR (ApiBanco)
PASARELA_BASE_URL="https://apibanco.tu-dominio.com"
PASARELA_API_KEY="tu_api_key_aqui"
PASARELA_WEBHOOK_SECRET="tu_webhook_secret_aqui"
QR_EXPIRATION_MINUTES=30

# Integración n8n (Difusión en Redes Sociales)
# En Docker usa automáticamente http://n8n:5678/webhook/difusion-inmueble si no se sobreescribe
N8N_DIFFUSION_WEBHOOK_URL="http://localhost:5678/webhook/difusion-inmueble"
N8N_CALLBACK_BASE_URL="http://backend:3000"
N8N_WEBHOOK_SECRET="secreto_compartido_n8n"
PUBLIC_APP_MAP_URL="https://tuapp.com/mapa"
PUBLIC_API_BASE_URL="https://api.tuapp.com"

# Configuración contenedor n8n y credenciales Meta Graph API
N8N_PORT=5678
N8N_HOST="localhost"
N8N_PROTOCOL="http"
N8N_PUBLIC_WEBHOOK_URL="http://localhost:5678/"
N8N_ENCRYPTION_KEY="cambia-esta-llave-secreta-de-32-caracteres"
N8N_SECURE_COOKIE="false"
META_PAGE_ID=""
META_IG_USER_ID=""
META_PAGE_ACCESS_TOKEN=""

# Vigencia en meses del sello "Inmueble Verificado"
VERIFICATION_VALID_MONTHS=6
